<!--
  Wazuh RMM Abuse Detection Pack  v1.0.0
  Detects remote monitoring and management (RMM) / remote access tools on Windows
  using Sysmon Event IDs 1 (process creation) and 22 (DNS query).
  MITRE ATT&amp;CK: T1219 Remote Access Software
  Requires: Sysmon on the endpoint and the Wazuh agent collecting
            Microsoft-Windows-Sysmon/Operational.
  Rule IDs: 100900 - 100999
  Independent community project. Not affiliated with or endorsed by Wazuh, Inc.
-->

<group name="rmm_abuse,windows,sysmon,tsc_CC6.8,tsc_CC7.2,nist_800_53_SI.4,nist_800_53_CM.7,">

  <!-- 1. HIGH-CONFIDENCE BEHAVIOUR (placed before the tool-name rules) -->

  <!-- Renamed RMM binary: internal file name is an RMM tool, but it runs under another name -->
  <rule id="100900" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^(anydesk|(teamviewer|teamviewer_service|tv_w32|tv_x64)|screenconnect\.[a-z.]+|ateraagent|(srservice|srmanager|srapp|strwinclt)|rustdesk|(logmein|lmiguardiansvc|logmeinsystray)|client32|aa_v\d+|(rserver3|radmin)|(ultraviewer_desktop|ultraviewer_service)|(supremo|supremoservice|supremohelper)|aeroadmin|(rutserv|rfusclient|rutview)|meshagent|tacticalrmm|ninjarmmagent|action1_agent|(dwagent|dwagsvc)|remoting_host|(tvnserver|winvnc|vncserver)|(simplehelpcustomer|simpleservice))\.exe$</field>
    <field name="win.eventdata.image" type="pcre2" negate="yes">(?i)\\[^\\]*(anydesk|teamviewer|tv_w|tv_x|screenconnect|connectwise|splashtop|sr[a-z]|strwinclt|rustdesk|atera|logmein|lmi|netsupport|client32|aa_v|ammyy|radmin|rserver|ultraviewer|supremo|aeroadmin|rutserv|rfusclient|rutview|meshagent|meshcentral|tacticalrmm|ninjarmm|ninjaone|action1|dwagent|dwagsvc|remoting_|vnc|simplehelp|simpleservice)[^\\]*\.exe$</field>
    <description>RMM abuse: renamed remote access tool. $(win.eventdata.originalFileName) is running as $(win.eventdata.image) on $(win.system.computer)</description>
    <mitre>
      <id>T1219</id>
      <id>T1036.003</id>
    </mitre>
    <group>rmm_detection,rmm_renamed,</group>
  </rule>

  <!-- Renamed RMM binary detected by its Product name (AnyDesk and some others ship without an OriginalFileName) -->
  <rule id="100902" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.product" type="pcre2">(?i)^(anydesk|teamviewer|screenconnect|connectwise control|splashtop|rustdesk|atera|logmein|netsupport|ammyy|radmin|ultraviewer|supremo|aeroadmin|remote utilities|mesh ?(central|agent)|tactical ?rmm|ninja ?(rmm|one)|action1|dw ?(service|agent)|chrome remote desktop|(tight|ultra|real) ?vnc|simplehelp)</field>
    <field name="win.eventdata.image" type="pcre2" negate="yes">(?i)\\[^\\]*(anydesk|teamviewer|tv_w|tv_x|screenconnect|connectwise|splashtop|sr[a-z]|strwinclt|rustdesk|atera|logmein|lmi|netsupport|client32|aa_v|ammyy|radmin|rserver|ultraviewer|supremo|aeroadmin|rutserv|rfusclient|rutview|meshagent|meshcentral|tacticalrmm|ninjarmm|ninjaone|action1|dwagent|dwagsvc|remoting_|vnc|simplehelp|simpleservice)[^\\]*\.exe$</field>
    <description>RMM abuse: renamed remote access tool. $(win.eventdata.product) by $(win.eventdata.company) is running as $(win.eventdata.image) on $(win.system.computer)</description>
    <mitre>
      <id>T1219</id>
      <id>T1036.003</id>
    </mitre>
    <group>rmm_detection,rmm_renamed,</group>
  </rule>

  <!-- RMM tool launched a command shell or script host -->
  <rule id="100901" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(anydesk|(teamviewer|teamviewer_service|tv_w32|tv_x64)|screenconnect\.[a-z.]+|ateraagent|(srservice|srmanager|srapp|strwinclt)|rustdesk|(logmein|lmiguardiansvc|logmeinsystray)|client32|aa_v\d+|(rserver3|radmin)|(ultraviewer_desktop|ultraviewer_service)|(supremo|supremoservice|supremohelper)|aeroadmin|(rutserv|rfusclient|rutview)|meshagent|tacticalrmm|ninjarmmagent|action1_agent|(dwagent|dwagsvc)|remoting_host|(tvnserver|winvnc|vncserver)|(simplehelpcustomer|simpleservice))\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$</field>
    <description>RMM abuse: $(win.eventdata.parentImage) launched $(win.eventdata.image) on $(win.system.computer). Command: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1219</id>
      <id>T1059</id>
    </mitre>
    <group>rmm_detection,rmm_shell,</group>
  </rule>

